# =============================================================================
# Bingo Backend - Environment Variables
# Copy to .env for local dev, or configure these in your Render dashboard.
# =============================================================================

# --- Telegram Bot ---
BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=your_bot_username
WEBAPP_URL=https://your-app.vercel.app

# --- Database ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=bingo_db

# --- Redis (Upstash) ---
# REST credentials (used for locks, rate limiting, PIN attempts):
REDIS_URL=https://your-upstash-instance.upstash.io
REDIS_TOKEN=your_redis_token
# Optional: Upstash's Redis-protocol (TCP) connection string. Only needed if
# you run more than one backend instance and want Socket.IO events to fan
# out across them via @socket.io/redis-adapter. A single Render instance
# (the default for this project's scale) works correctly without it.
# REDIS_TCP_URL=rediss://default:password@your-upstash-instance:6379

# --- Admin Credentials ---
ADMIN_ID=123456789
ADMIN_PIN=1234
ADMIN_PIN_ATTEMPTS_KEY=admin_pin_attempts

# --- House Wallet ---
# Initial seed capital the house uses to cover admin auto-allocated
# cartelas (§6.3-6.5) until commission earnings replenish it.
HOUSE_WALLET_INITIAL_BALANCE=50000

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRY=7d

# --- Rate Limiting ---
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_MAX_REQUESTS=100

# --- Game Configuration (single stake tier: 10 Birr) ---
DRAW_INTERVAL=3
CARTELA_SELECTION_TIME=45
# Minimum cartelas needed to guarantee MIN_PRIZE_POOL net. Derived as
# ceil(MIN_PRIZE_POOL / (STAKE_AMOUNT * (1 - HOUSE_COMMISSION))) — 150 is
# correct for the defaults below. Recompute this if you change the stake,
# the commission rate, or the guaranteed floor.
MIN_CARTELAS=150
MIN_PRIZE_POOL=1200
HOUSE_COMMISSION=0.2
MAX_CARTELAS_PER_USER=2
STAKE_AMOUNT=10

# --- Deposit Configuration ---
DEPOSIT_PHONE_NUMBER=0968200522
DEPOSIT_MIN_AMOUNT=10
DEPOSIT_MAX_AMOUNT=50000

# --- Withdrawal Configuration ---
WITHDRAW_MIN_AMOUNT=50
WITHDRAW_MAX_AMOUNT=15000
WITHDRAW_HOLD_TIMEOUT=172800

# --- Telebirr Verification ---
# Self-contained (backend/src/services/telebirrVerification.js) — parses the
# pasted confirmation SMS, fetches the official transactioninfo.ethiotelecom.et
# receipt, and cross-checks it. No external package required. See README's
# "Telebirr Deposit Verification" section for the known limitation on the
# receipt-page parser specifically.
# Deposits fall back to manual admin review automatically if it's absent.
TELEBIRR_VERIFICATION_TIMEOUT=120

# --- Networking ---
PORT=5000
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://your-backend.onrender.com

# --- Logging ---
LOG_LEVEL=info
