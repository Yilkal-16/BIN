# =============================================================================
# Bingo Webapp - Environment Variables
# Configure these in your Vercel project settings (or .env.local for dev).
#
# Next.js only exposes env vars to browser code when they're prefixed with
# NEXT_PUBLIC_ — that's a framework requirement, not a naming choice made
# here. Set these to the SAME backend deployment referenced by the
# backend's own BACKEND_URL / WS_SERVER_URL (they're the same Render
# service; REST and WebSocket just use different URL schemes).
# =============================================================================

NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com
NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com

# Shown in the Deposit tab's instructions. Keep in sync with the backend's
# DEPOSIT_PHONE_NUMBER.
NEXT_PUBLIC_DEPOSIT_PHONE=0968200522
